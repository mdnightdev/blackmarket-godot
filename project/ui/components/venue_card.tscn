[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/components/venue_card.gd" id="1_card"]

[node name="VenueCard" type="Button"]
custom_minimum_size = Vector2(0, 80)
theme_type_variation = &"VenueButton"
script = ExtResource("1_card")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_right = 20

[node name="Row" type="HBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Text" type="VBoxContainer" parent="Margin/Row"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 2
alignment = 1

[node name="NameLabel" type="Label" parent="Margin/Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudValueLabel"

[node name="TaglineLabel" type="Label" parent="Margin/Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text_overrun_behavior = 3

[node name="StatusLabel" type="Label" parent="Margin/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"PillLabel"
text = "SOON"
