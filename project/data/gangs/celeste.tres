[gd_resource type="Resource" script_class="GangDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/defs/gang_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"celeste"
display_name = "Celeste"
crew_name = "Celeste's crew"
boss = &"celeste"
style = 2
turf = Array[StringName]([&"west_end", &"the_heights"])
strongholds = {
&"the_heights": 30
}
color = Color(0.4902, 0.5608, 0.702, 1)
gate_title = "Celeste knows your face"
gate_line = "My people have watched you work %s all week. The police would love those notes. Make it worth my while to keep them."
hunt_title = "Celeste sent for you"
hunt_line = "You turned down my offer too many times, darling. My crew will see you settle the account, one way or another."
ambush_line = "A crate from Voronin, how exciting. Share a little, or I share the route with someone in uniform."
dealer_line = "Celeste's people take a cut of every sale up here. Discretion is expensive."
victory_title = "Celeste is out"
victory_line = "Well played. I know when a city stops being fun. My apartment and its safe are yours, %s inside. Do redecorate."
max_gate_chance = 0.3
bribe_base = 400
bribe_per_anger = 150
hunt_fee = 900
max_push = 6
victory_reward = 9000
