hunt_line = "In Gdansk we sink people who dodge the tariff. Pay the arrears or my riflemen finish this."
ambush_line = "Voronin knows my rules on the water. Leave a cut of that crate on the pier or nobody leaves."
dealer_line = "Lucyferek's syndicate taxes every berth on the water. Her cut comes off the top."
victory_title = "Lucyferek is out"
victory_line = "Zrozumiano. You have the men to hold the water. The harbour office and its safe are yours, %s inside."
