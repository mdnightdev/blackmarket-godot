[resource]
script = ExtResource("1_def")
id = &"lucyferek"
display_name = "Lucyferek"
crew_name = "Lucyferek's crew"
boss = &"lucyferek"
style = 0
turf = Array[StringName]([&"north_port", &"docks"])
