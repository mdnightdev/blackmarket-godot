line = "Nothing comes off the water without my stamp on the manifest. Pay your harbour fee."
blurb = "Polish syndicate boss who runs North Port and the northern cranes of The Docks. Miss her cut and her gunmen board you before sunrise."
route = Array[StringName]([&"north_port", &"docks"])
