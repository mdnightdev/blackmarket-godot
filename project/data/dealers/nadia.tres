[gd_resource type="Resource" script_class="DealerDef" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/models/dealer_def.gd" id="1_def"]
[ext_resource type="Texture2D" path="res://assets/portraits/nadia.jpg" id="2_portrait"]
[ext_resource type="Texture2D" path="res://assets/portraits/nadia_talk.jpg" id="3_talk"]

[resource]
script = ExtResource("1_def")
id = &"nadia"
display_name = "Nadia Volkova"
district_id = &"old_market"
greeting = "Cash first. Questions never."
portrait = ExtResource("2_portrait")
talk_portrait = ExtResource("3_talk")
stock_categories = Array[StringName]([&"comms", &"papers", &"meds", &"luxury"])
price_bias = {
&"comms": 0.95,
&"papers": 1.0,
&"meds": 1.0,
&"luxury": 1.05,
&"tech": 1.07,
&"arms": 1.1
}
