&"luxury": 0.8,
&"papers": 0.85,
&"tech": 1.05,
&"comms": 1.1,
&"meds": 1.2,
&"arms": 1.3
}
haggle_tolerance = 0.1
route = Array[StringName]([&"north_port", &"old_market", &"slums"])
working_phases = Array[int]([0, 1, 2])
