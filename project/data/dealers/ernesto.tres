[resource]
script = ExtResource("1_def")
id = &"ernesto"
display_name = "Don Ernesto"
district_id = &"old_market"
greeting = "Everything has a price, mijo. Discretion costs extra."
portrait = ExtResource("2_portrait")
talk_portrait = ExtResource("3_talk")
stock_categories = Array[StringName]([&"papers", &"tech", &"comms", &"tool"])
route = Array[StringName]([&"old_market", &"docks", &"slums"])
