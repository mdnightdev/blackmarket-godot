&"tech": 0.82,
&"luxury": 0.85,
&"comms": 1.05,
&"papers": 1.1,
&"meds": 1.15,
&"arms": 1.25
}
haggle_tolerance = 0.08
route = Array[StringName]([&"docks", &"north_port", &"slums"])
working_phases = Array[int]([1, 2, 3])
