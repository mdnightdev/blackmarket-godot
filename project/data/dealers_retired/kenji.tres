[gd_resource type="Resource" script_class="DealerDef" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/models/dealer_def.gd" id="1_def"]
[ext_resource type="Texture2D" path="res://assets/portraits/kenji.jpg" id="2_portrait"]
[ext_resource type="Texture2D" path="res://assets/portraits/kenji_talk.jpg" id="3_talk"]

[resource]
script = ExtResource("1_def")
id = &"kenji"
display_name = "Kenji Mori"
district_id = &"north_port"
greeting = "No names. No receipts. No second offers."
portrait = ExtResource("2_portrait")
talk_portrait = ExtResource("3_talk")
stock_categories = Array[StringName]([&"tech", &"comms"])
price_bias = {
&"tech": 0.75,
&"comms": 0.85,
&"luxury": 1.05,
&"papers": 1.07,
&"meds": 1.1,
&"arms": 1.12
}
route = Array[StringName]([&"north_port", &"docks", &"old_market"])
working_phases = Array[int]([2, 3])
