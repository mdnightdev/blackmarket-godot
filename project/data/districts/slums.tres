[resource]
script = ExtResource("1_def")
id = &"slums"
display_name = "The Slums"
tagline = "Narrow alleys, loose rules"
description = "Stacked blocks and steaming grates. Police rarely come this far in, which is exactly why Vex runs her crew from here."
background = ExtResource("2_background")
ambient_effect = ExtResource("3_effect")
map_position = Vector2(0.82, 0.57)
travel_cost = 30
heat_multiplier = 0.8
roads = Array[StringName]([&"warehouse_row", &"old_market", &"docks"])
venues = Array[StringName]([&"market"])
allowed_businesses = Array[StringName]([&"corner_shop", &"car_wash", &"bakery", &"pawn_shop"])
corner_map = ExtResource("5_corner_map")
corners = Array[ExtResource("4_corner")]([SubResource("Corner_steam_grate_alley"), SubResource("Corner_block_nine"), SubResource("Corner_laundry_court"), SubResource("Corner_boiler_house")])
