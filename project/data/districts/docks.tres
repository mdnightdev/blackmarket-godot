[resource]
script = ExtResource("1_def")
id = &"docks"
display_name = "The Docks"
tagline = "Cargo moves at night"
description = "Cranes, containers and harbour fog. Half the city's contraband passes through here before sunrise."
background = ExtResource("2_background")
ambient_effect = ExtResource("3_effect")
map_position = Vector2(0.6, 0.7)
travel_cost = 60
heat_multiplier = 1.2
roads = Array[StringName]([&"slums", &"downtown", &"riverside"])
venues = Array[StringName]([&"docks", &"market"])
corner_map = ExtResource("5_corner_map")
corners = Array[ExtResource("4_corner")]([SubResource("Corner_container_yard"), SubResource("Corner_menders_pier"), SubResource("Corner_crane_seven"), SubResource("Corner_customs_shed")])
