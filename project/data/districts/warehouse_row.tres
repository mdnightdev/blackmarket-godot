[resource]
script = ExtResource("1_def")
id = &"warehouse_row"
display_name = "Geylang"
tagline = "Gear, parts, no questions"
description = "Brick warehouses and roll-up doors. If you need a van, a weapon or a tool that is not on any receipt, ask here."
background = ExtResource("2_background")
ambient_effect = ExtResource("3_effect")
map_position = Vector2(0.78, 0.3)
travel_cost = 80
heat_multiplier = 1.0
roads = Array[StringName]([&"north_port", &"old_market", &"slums", &"golden_mile"])
venues = Array[StringName]([&"supply"])
corner_map = ExtResource("5_corner_map")
corners = Array[ExtResource("4_corner")]([SubResource("Corner_loading_bay"), SubResource("Corner_roll_up_row"), SubResource("Corner_scrap_yard"), SubResource("Corner_jackal_lockup")])
