[resource]
script = ExtResource("1_def")
id = &"riverside"
display_name = "Riverside"
tagline = "Lofts over the water"
tier = 2
description = "Old warehouses turned into lofts and labs. Chop shops hum under the bridges and nobody asks what the river carries."
background = ExtResource("2_background")
ambient_effect = ExtResource("3_effect")
map_position = Vector2(0.3, 0.7)
travel_cost = 300
heat_multiplier = 1.2
venues = Array[StringName]([&"market", &"supply"])
roads = Array[StringName]([&"docks", &"downtown", &"west_end"])
min_rank = 4
corner_map = ExtResource("5_corner_map")
corners = Array[ExtResource("4_corner")]([SubResource("Corner_under_the_bridge"), SubResource("Corner_loft_labs"), SubResource("Corner_ferry_steps"), SubResource("Corner_pump_house")])
