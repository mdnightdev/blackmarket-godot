travel_cost = 120
heat_multiplier = 1.4
roads = Array[StringName]([&"old_market", &"docks", &"west_end", &"riverside"])
venues = Array[StringName]([&"loan_shark", &"la_paloma", &"casino"])
corner_map = ExtResource("5_corner_map")
corners = Array[ExtResource("4_corner")]([SubResource("Corner_taxi_rank"), SubResource("Corner_level_b3"), SubResource("Corner_tower_lobby"), SubResource("Corner_glass_room")])
