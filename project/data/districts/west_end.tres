travel_cost = 300
heat_multiplier = 1.1
venues = Array[StringName]([&"market", &"casino"])
roads = Array[StringName]([&"downtown", &"old_market", &"riverside", &"the_heights"])
min_rank = 4
corner_map = ExtResource("5_corner_map")
