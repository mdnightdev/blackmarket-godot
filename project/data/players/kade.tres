[gd_resource type="Resource" script_class="PlayerDef" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/models/player_def.gd" id="1_def"]
[ext_resource type="Texture2D" path="res://assets/portraits/player_kade.jpg" id="2_portrait"]
[ext_resource type="Texture2D" path="res://assets/portraits/player_kade_talk.jpg" id="3_talk"]

[resource]
script = ExtResource("1_def")
id = &"kade"
display_name = "Kade"
portrait = ExtResource("2_portrait")
talk_portrait = ExtResource("3_talk")
tagline = "Former courier. Knows every back road."
intro_line = "I know every back road in this city. Time that paid off."
edge = 2
edge_text = "Routes: shorter trips and fewer road stops."
origin_story = "Kade took a delivery for Voronin, no questions asked. A police blockade on the river road, and the crate was gone. Voronin wanted paying. The Shark paid Voronin and bought Kade's problem."
origin_lines = Array[Dictionary]([{
"line": "I told them the road was hot. They said drive anyway.",
"speaker": "player"
}, {
"line": "And now the Shark owns the road you're on. Come on. I'll walk you up.",
"speaker": "midnight_rabbit"
}])
