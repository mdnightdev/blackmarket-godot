; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can be edited directly if you know what you are doing.

config_version=5

[application]

config/name="BLACK MARKET"
config/version="1.0.0-dev+6fd1b3f"
run/main_scene="res://ui/screens/title/title_screen.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icons/app_icon.png"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.0392, 0.0392, 0.0431, 1)
#boot_splash/show_image="res://ui/screens/title/title_screen.tscn"
#boot_splash/fullsize=true
#boot_splash/use_filter=true

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

Settings="*res://scripts/core/settings.gd"
Content="*res://scripts/core/content.gd"
GameState="*res://scripts/core/game_state.gd"
AudioService="*res://scripts/core/audio_service.gd"
SceneRouter="*res://scripts/core/scene_router.gd"
GameOverlay="*res://scripts/core/game_overlay.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

theme/custom="res://theme/theme.tres"
common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=true
sensors/enable_accelerometer=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0392, 0.0392, 0.0431, 1)
